# --- Banco de Dados ---
DATABASE_URL=postgresql+psycopg2://leitor:leitor@localhost:5432/leitor
DB_USER=leitor
DB_PASSWORD=leitor
DB_NAME=leitor
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Celery broker + resultado) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=db+postgresql://leitor:leitor@localhost:5432/leitor

# --- LLM Local (Qwen3.6-35B) ---
LLM_BASE_URL=http://192.168.2.112:8000/v1/
LLM_API_KEY=local
LLM_MODEL=qwen3.6-35b
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# --- TTS Local (Qwen3-TTS) ---
TTS_BASE_URL=http://192.168.2.112:8881
TTS_TIMEOUT=120
TTS_MAX_RETRIES=3

# --- Dataset de Vozes ---
DATASET_PATH=./dataset

# --- Armazenamento ---
STORAGE_PATH=./storage
UPLOAD_PATH=./uploads
AUDIO_OUTPUT_PATH=./output

# --- Aplicação ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO
